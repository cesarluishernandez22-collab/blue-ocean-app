# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AIRTABLE_API_KEY: Personal Access Token (PAT) for Airtable API
AIRTABLE_API_KEY=""

# AIRTABLE_BASE_ID: The Base ID for the "Hoteles" Airtable base (starts with 'app...')
AIRTABLE_BASE_ID=""

# SUPABASE_URL: URL of your Supabase project (from Project Settings -> API)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Anon/public key of your Supabase project (from Project Settings -> API)
SUPABASE_ANON_KEY=""
